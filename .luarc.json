{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime.version": "Lua 5.4",
  "runtime.path": ["my-brain/lua/?.lua"],
  "runtime.builtin": {
    "io": "disable",
    "os": "disable",
    "debug": "disable",
    "package": "disable",
    "coroutine": "disable"
  },
  "workspace.library": ["types"],
  "workspace.ignoreDir": ["dist", "tools"]
}
